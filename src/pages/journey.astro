---
import Layout from "../layouts/Layout.astro";
import JourneyIsland from "../components/islands/JourneyIsland.tsx";

const posts = await Astro.glob('../content/journey/*.md');

const journeyPosts = posts.map(post => {
    const slug = post.file.split('/').pop()?.split('.').shift() || '';
    return {
        slug,
        ...post.frontmatter
    };
});
---

<Layout title="Journey | Fazrin Portfolio">
    <JourneyIsland client:idle journeyPosts={journeyPosts} />
</Layout>
