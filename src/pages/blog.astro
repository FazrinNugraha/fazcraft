---
import Layout from "../layouts/Layout.astro";
import BlogIsland from "../components/islands/BlogIsland.tsx";

const posts = await Astro.glob('../content/blog/*.md');

const blogPosts = posts.map(post => {
    const slug = post.file.split('/').pop()?.split('.').shift() || '';
    return {
        slug,
        ...post.frontmatter
    };
});
---

<Layout title="Articles | Fazrin Portfolio">
    <BlogIsland client:idle blogPosts={blogPosts} />
</Layout>
