---
import Layout from "../../layouts/Layout.astro";
import BlogDetailIsland from "../../components/islands/BlogDetailIsland.tsx";

export async function getStaticPaths() {
    const posts = await Astro.glob('../../content/blog/*.md');

    return posts.map(post => {
        const slug = post.file.split('/').pop()?.split('.').shift() || '';
        return {
            params: { slug },
            props: { post }
        };
    });
}

const { post } = Astro.props;
const { Content } = post;
---

<Layout
    title={post.frontmatter?.title ? `${post.frontmatter.title} | Fazrin Portfolio` : "Article | Fazrin Portfolio"}
    description={post.frontmatter?.description}
>
    <BlogDetailIsland client:idle frontmatter={post.frontmatter}>
        <Content />
    </BlogDetailIsland>
</Layout>
