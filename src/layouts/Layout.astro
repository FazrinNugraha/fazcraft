---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Fazrin | Portfolio",
  description = "Full-stack developer crafting user-centric web solutions with React, Node.js, and modern technologies.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="no-transition">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#141414" />

    <!--
      CRITICAL: Theme initialization script MUST run before paint
      to prevent Flash of Un-themed Content (FOUC) and sync <meta name="color-scheme">
    -->
    <script is:inline>
      (function () {
        var savedTheme = null;
        try {
          savedTheme = localStorage.getItem("theme");
        } catch (e) {}

        var root = document.documentElement;
        var isLight = savedTheme === "light";
        var schemeMeta = document.querySelector('meta[name="color-scheme"]');
        var themeColorMeta = document.querySelector('meta[name="theme-color"]');

        if (isLight) {
          root.classList.add("light-theme");
          root.classList.remove("dark-theme");
        } else {
          root.classList.add("dark-theme");
          root.classList.remove("light-theme");
        }

        if (schemeMeta) {
          schemeMeta.setAttribute("content", isLight ? "light" : "dark");
        }
        if (themeColorMeta) {
          themeColorMeta.setAttribute("content", isLight ? "#f9fafb" : "#141414");
        }

        // Re-enable transitions after first paint so toggle still animates
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            root.classList.remove("no-transition");
          });
        });
      })();
    </script>

    <!-- Block all transitions during initial page load to prevent flash -->
    <style is:inline>
      .no-transition,
      .no-transition *,
      .no-transition *::before,
      .no-transition *::after {
        transition: none !important;
      }
    </style>

    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <ClientRouter />

    <!-- Handle theme persistence during Astro View Transitions -->
    <script is:inline>
      document.addEventListener("astro:before-swap", function (event) {
        var currentTheme = null;
        try {
          currentTheme = localStorage.getItem("theme");
        } catch (e) {}

        var newDoc = event.newDocument;
        var newRoot = newDoc.documentElement;
        var isLight = currentTheme === "light";

        // Block transitions during swap to prevent flash
        newRoot.classList.add("no-transition");

        if (isLight) {
          newRoot.classList.add("light-theme");
          newRoot.classList.remove("dark-theme");
        } else {
          newRoot.classList.add("dark-theme");
          newRoot.classList.remove("light-theme");
        }

        var schemeMeta = newDoc.querySelector('meta[name="color-scheme"]');
        if (schemeMeta) {
          schemeMeta.setAttribute("content", isLight ? "light" : "dark");
        }
        var themeColorMeta = newDoc.querySelector('meta[name="theme-color"]');
        if (themeColorMeta) {
          themeColorMeta.setAttribute("content", isLight ? "#f9fafb" : "#141414");
        }
      });

      document.addEventListener("astro:after-swap", function () {
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            document.documentElement.classList.remove("no-transition");
          });
        });
      });
    </script>

    <!-- Optimized Google Fonts Loading (Non-render-blocking) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600;700&family=Geist:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600;700&family=Geist:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600;700&family=Geist:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      />
    </noscript>
  </head>
  <body class="font-sans transition-colors duration-300 antialiased">
    <slot />
  </body>
</html>
